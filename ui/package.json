    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-table": "9.3.1",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
