# Generated by go generate ./internal/config; do not edit.
# Driga reads the process environment, never dotenv files.
# Precedence: explicit flags > environment > TOML file > defaults.
# Empty environment values are unset. All settings are optional unless stated.
# Restart collector after changing its configuration; CLI/hooks reload per invocation.

# roots: list; default=[]; optional. Additional repository discovery roots; ~ expands to HOME.
# Allowed: file-only; empty = session working directories only.
# File-only structured list; no environment separator.

# root_depth: int; default=3; optional. Repository discovery depth.
# Allowed: 0..max int; zero = roots only.
# DRIGA_ROOT_DEPTH=

# exclude: list; default=[**/node_modules **/.tmp/**]; optional. Repository discovery exclusions.
# Allowed: file-only; empty = no exclusions.
# File-only structured list; no environment separator.

# stalled_after: duration; default=10m; optional. Quiet busy-session threshold.
# Allowed: 0..2562047h47m16.854775807s; zero = default 10m.
# DRIGA_STALLED_AFTER=

# orphan_min_age: duration; default=10m; optional. Minimum orphan candidate age.
# Allowed: 0..2562047h47m16.854775807s; zero = no age minimum.
# DRIGA_ORPHAN_MIN_AGE=

# capture_text: string; default=titles; optional. Local text capture policy.
# Allowed: titles or snippets.
# DRIGA_CAPTURE_TEXT=

# open_cmd: string; default=; optional. Editor command; {cwd} is substituted.
# Allowed: empty = auto-detect.
# DRIGA_OPEN_CMD=

# no_service_hint: bool; default=false; optional. Suppress optional service hints.
# Allowed: true or false.
# DRIGA_NO_SERVICE_HINT=

# adapters.claude.enabled: bool; default=true; optional. Enable Claude session discovery.
# Allowed: true or false.
# DRIGA_ADAPTERS_CLAUDE_ENABLED=

# adapters.codex.enabled: bool; default=true; optional. Enable Codex session discovery.
# Allowed: true or false.
# DRIGA_ADAPTERS_CODEX_ENABLED=

# adapters.gemini.enabled: bool; default=true; optional. Enable Gemini session discovery.
# Allowed: true or false.
# DRIGA_ADAPTERS_GEMINI_ENABLED=

# orphans.extra_signatures: list; default=[]; optional. Additional signature files; ~ expands to HOME.
# Allowed: file-only; empty = built-in signatures.
# File-only structured list; no environment separator.

# summaries.enabled: bool; default=false; optional. Enable optional local Claude summaries.
# Allowed: true or false.
# DRIGA_SUMMARIES_ENABLED=

# summaries.model: string; default=haiku; optional. Model selection passed to the Claude CLI.
# Allowed: nonempty.
# DRIGA_SUMMARIES_MODEL=

# cleanup.worktree_idle: duration; default=168h; optional. Idle worktree cleanup eligibility.
# Allowed: 0..2562047h47m16.854775807s; zero = no idle minimum.
# DRIGA_CLEANUP_WORKTREE_IDLE=

# cleanup.low_disk_percent: float; default=10; optional. Low free-disk threshold in percent (minimum of percent and bytes).
# Allowed: 0..100; zero disables low-disk warnings.
# DRIGA_CLEANUP_LOW_DISK_PERCENT=

# cleanup.low_disk_bytes: size; default=10GiB; optional. Low free-disk threshold in bytes; optional KiB/MiB/GiB suffix (minimum of percent and bytes).
# Allowed: 0..18446744073709551615 bytes; zero disables low-disk warnings.
# DRIGA_CLEANUP_LOW_DISK_BYTES=

# cleanup.regenerable: list; default=[node_modules/ target/ .venv/ venv/ dist/ build/ .next/ __pycache__/ .gradle/ .terraform/]; optional. Additional regenerable relative directories (merged with defaults).
# Allowed: file-only; empty = built-in directories.
# File-only structured list; no environment separator.

# fleet.serve: bool; default=false; optional. Enable optional fleet serving.
# Allowed: true or false; requires fleet.listen.
# DRIGA_FLEET_SERVE=

# fleet.listen: string; default=; optional. Fleet TCP listener address.
# Allowed: required with fleet.serve; explicit private IP/interface, public addresses require allow_any_address.
# DRIGA_FLEET_LISTEN=

# fleet.share_text: string; default=titles; optional. Fleet export text policy, bounded by local capture policy.
# Allowed: none, titles or snippets.
# DRIGA_FLEET_SHARE_TEXT=

# fleet.enroll_window: duration; default=10m; optional. Fleet enrollment duration.
# Allowed: 1ns..10m; zero rejected.
# DRIGA_FLEET_ENROLL_WINDOW=

# fleet.allow_any_address: bool; default=false; optional. Permit explicit non-loopback fleet listener.
# Allowed: true or false.
# DRIGA_FLEET_ALLOW_ANY_ADDRESS=

# inbox.alerts: string; default=waiting; optional. Desktop alerts for attention and optionally completions.
# Allowed: waiting, all or off.
# DRIGA_INBOX_ALERTS=

# inbox.alert_after: duration; default=0s; optional. Suppress alerts when same-session activity preceded the wait within this interval.
# Allowed: 0..2562047h47m16.854775807s; zero = alert immediately.
# DRIGA_INBOX_ALERT_AFTER=

# inbox.alert_repeat: duration; default=5m; optional. Minimum interval between alerts for one session.
# Allowed: 0..2562047h47m16.854775807s; zero = no throttle.
# DRIGA_INBOX_ALERT_REPEAT=

# inbox.jump_terminal: bool; default=false; optional. Opt in to bringing a proven macOS terminal window to front.
# Allowed: true or false.
# DRIGA_INBOX_JUMP_TERMINAL=

# intake.otlp: bool; default=false; optional. Enable optional loopback OTLP/HTTP JSON intake.
# Allowed: true or false.
# DRIGA_INTAKE_OTLP=

# intake.listen: string; default=127.0.0.1:7418; optional. OTLP intake TCP listener address.
# Allowed: loopback IP and port 0..65535; zero = ephemeral port.
# DRIGA_INTAKE_LISTEN=

# Path overrides and internal/test namespace extensions.
# DRIGA_CONFIG: path; default=$XDG_CONFIG_HOME/driga/config.toml or ~/.config/driga/config.toml; optional. Configuration file override.
# DRIGA_CONFIG=

# DRIGA_DATA_DIR: path; default=Linux: $XDG_DATA_HOME/driga or ~/.local/share/driga; macOS: ~/Library/Application Support/driga; optional. Database and fleet data directory override.
# DRIGA_DATA_DIR=

# DRIGA_SPOOL_DIR: path; default=Linux: $XDG_STATE_HOME/driga/events or ~/.local/state/driga/events; macOS: $XDG_STATE_HOME/driga/events or ~/Library/Application Support/driga/events; optional. Hook/ack spool directory override; disables legacy migration.
# DRIGA_SPOOL_DIR=

# DRIGA_INTERNAL: marker; default=unset; optional. 1 suppresses recursive hooks from Driga-owned Claude subprocesses.
# DRIGA_INTERNAL=

# DRIGA_FIXTURE_OUTPUT: path; default=unset; optional. Fixture generator output directory (tests only).
# DRIGA_FIXTURE_OUTPUT=

# DRIGA_COLLECTOR_HEAP_CHILD: marker; default=unset; optional. 1 selects isolated collector heap-test child.
# DRIGA_COLLECTOR_HEAP_CHILD=

# DRIGA_FLEET_HEAP_CHILD: marker; default=unset; optional. 1 selects isolated fleet heap-test child.
# DRIGA_FLEET_HEAP_CHILD=

# DRIGA_OTLP_TRACES_ADDED: marker; default=unset; optional. 1 records enhanced telemetry installed by Driga in Claude settings.
# DRIGA_OTLP_TRACES_ADDED=

# DRIGA_JSON_WATCH_CHILD: marker; default=unset; optional. 1 selects isolated NDJSON watch-test child.
# DRIGA_JSON_WATCH_CHILD=

# DRIGA_TEST_MCP_PROCESS: marker; default=unset; optional. 1 selects isolated MCP-test child.
# DRIGA_TEST_MCP_PROCESS=

