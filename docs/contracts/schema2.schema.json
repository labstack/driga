{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driga schema 2 read envelopes and CLI error records",
  "type": "object",
  "required": ["schema"],
  "anyOf": [{"required": ["data"]}, {"required": ["error"]}],
  "properties": {
    "schema": {"const": 2},
    "observed_at": {"$ref": "#/$defs/utc_instant"},
    "mode": {"enum": ["daemon", "snapshot"]},
    "freshness": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["last_ok_at", "age_ms", "stale", "last_error"],
        "properties": {
          "last_ok_at": {"$ref": "#/$defs/utc_instant"},
          "age_ms": {"$ref": "#/$defs/duration_ms"},
          "stale": {"type": "boolean"},
          "last_error": {"type": "string"},
          "status": {"enum": ["last_event", "not_yet_receiving"]}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["machine_id", "started_at", "ended_at"],
        "properties": {
          "machine_id": {"type": "string"},
          "started_at": {"$ref": "#/$defs/utc_instant"},
          "ended_at": {"$ref": "#/$defs/utc_instant"}
        }
      }
    },
    "data": {
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "lead",
              "children"
            ]
          },
          "then": {
            "$ref": "#/$defs/flow"
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "rows"
            ]
          },
          "then": {
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "if": {
                    "type": "object",
                    "required": [
                      "kind",
                      "session_id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "waiting",
                          "finished",
                          "worker_finished"
                        ]
                      }
                    }
                  },
                  "then": {
                    "$ref": "#/$defs/inbox_item"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "truncated": {"type": "boolean", "description": "Always present for MCP; true when the limit omits entries."},
    "error": {"$ref": "#/$defs/error"}
  },
  "$defs": {
    "flow": {
      "type": "object",
      "required": ["lead", "children"],
      "properties": {
        "lead": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/flow_node"}]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/flow_node"}}
      }
    },
    "flow_node": {
      "type": "object",
      "required": ["observed"],
      "properties": {"reason": {"enum": ["permission", "question", "idle", "elicitation", "unknown"]}, "observed": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/flow_observed"}]}}
    },
    "flow_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_bytes_per_min", "cpu_ms_per_min", "last_growth_at", "last_growth_bytes"],
      "properties": {
        "log_bytes_per_min": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/size_bytes"}},
        "cpu_ms_per_min": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/duration_ms"}},
        "last_growth_at": {"$ref": "#/$defs/utc_instant"},
        "last_growth_bytes": {"$ref": "#/$defs/size_bytes"}
      },
      "description": "Collector metadata only; oldest first, current minute plus preceding 59. Null observed means no retained positive measurements. Zero last_growth_at means CPU-only observations."
    },
    "inbox_jump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["tmux", "resume", "terminal", "vendor"]},
        "command": {"type": "string"},
        "target": {"type": "string"},
        "cwd": {"type": "string"},
        "server": {"type": "string"},
        "app": {"type": "string"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "inbox_item": {
      "type": "object",
      "required": ["id", "session_id", "kind", "occurred_at", "summary"],
      "properties": {
        "id": {"type": "string"},
        "session_id": {"type": "integer"},
        "machine_id": {"type": "string"},
        "kind": {"enum": ["waiting", "finished", "worker_finished"]},
        "occurred_at": {"$ref": "#/$defs/utc_instant"},
        "reason": {"enum": ["permission", "question", "idle", "elicitation", "unknown"]},
        "source": {"enum": ["hook", "agents_cli", "both"]},
        "tool": {"type": "string", "maxLength": 200},
        "detail": {"type": "string", "maxLength": 200},
        "summary": {"type": "string"},
        "waiting_since_at": {"$ref": "#/$defs/utc_instant"},
        "waited_ms": {"$ref": "#/$defs/duration_ms"},
        "ended_at": {"$ref": "#/$defs/utc_instant"},
        "acked_at": {"$ref": "#/$defs/utc_instant"},
        "ack_pending_at": {"$ref": "#/$defs/utc_instant"},
        "jump": {"$ref": "#/$defs/inbox_jump"}
      },
      "if": {"properties": {"kind": {"const": "waiting"}}},
      "then": {"required": ["reason", "source", "waiting_since_at"]},
      "description": "One wait per machine/session/start. Automatic ended_at is independent of human acked_at; only acks synchronize as remote acknowledgements. waited_ms is computed by read surfaces and stops at the earlier end/ack."
    },
    "utc_instant": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "size_bytes": {"type": "integer", "minimum": 0},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "cleanup_outcome": {
      "type": "object",
      "required": ["id", "kind", "status"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["worktree", "scratch", "history"]},
        "status": {"enum": ["completed", "unchanged", "failed", "cancelled"]},
        "reason": {"type": "string"},
        "error": {"$ref": "#/$defs/error"},
        "result": {"type": "object"}
      }
    }
  }
}
